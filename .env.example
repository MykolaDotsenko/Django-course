# Explicit execution context: local | test | preview | production
APP_ENV=local

# Local defaults to true. Preview/production must be false.
DJANGO_DEBUG=true

# Comma-separated host names; do not include http:// or https://.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Optional for local/test. Required (>=50 chars) for preview/production.
# Set this locally when persistent sessions across process restarts are useful.
DJANGO_SECRET_KEY=

# Optional for local/test (SQLite is the zero-setup fallback).
# Required for preview/production.
DATABASE_URL=
